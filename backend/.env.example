# --- App ---
APP_NAME=OpenNotebook
DEBUG=true
# Change this in production to a long random string (min 32 chars for HS256).
SECRET_KEY=dev-only-change-me-0123456789abcdef0123456789abcdef
# Token lifetime in minutes (default: 7 days).
ACCESS_TOKEN_EXPIRE_MINUTES=10080

MONGODB_URI=mongodb://localhost:27017
DB_NAME=opennotebook

# --- CORS (comma-separated origins) ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

AWS_S3_BUCKET=opennotebook-files
AWS_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxx
AWS_SQS_QUEUE_URL=xxxxxxxxxxxxxxxxxxxxxxxx

QDRANT_API_KEY=eyJhbxxxxxxxxxxxxxxxxxxxxxxxxxxx
QDRANT_ENDPOINT=https://xxxxxxxxxxxxxxxxxxxxx


OPENROUTER_EMBEDDING_MODEL=perplexity/pplx-embed-v1-4b
OPENROUTER_CHAT_MODEL=deepseek/deepseek-v4-flash-0731
OPENROUTER_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
